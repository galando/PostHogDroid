# POSTHOG_PERSONAL_API_KEY: Personal API key from your PostHog account settings.
POSTHOG_PERSONAL_API_KEY=your_personal_api_key_here

# POSTHOG_PROJECT_ID: Project ID/Team ID found in your PostHog project settings URL.
POSTHOG_PROJECT_ID=your_project_id_here

# POSTHOG_HOST_URL: Instance base URL (e.g., https://app.posthog.com, https://eu.posthog.com).
POSTHOG_HOST_URL=https://app.posthog.com
